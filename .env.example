# ============================================================
# Configuration - copier ce fichier vers .env puis remplir
# Le fichier .env ne doit JAMAIS etre commite sur GitHub.
# ============================================================

# --- Application ---
APP_ENV=dev
# Cle de signature des sessions/cookies (generer : python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=changez-moi-par-une-valeur-aleatoire-de-64-caracteres

# Mode de fonctionnement :
#   local = capture reseau active (necessite Npcap/WinPcap + droits suffisants)
#   cloud = pas de capture, consultation de l'historique (deploiement en ligne)
APP_MODE=local

# --- Interfaces ---
# Laisser vide pour choisir automatiquement la premiere interface active
CAPTURE_IFACE=
# Nombre maximum de paquets gardes en memoire pour l'affichage temps reel
MAX_PACKETS_BUFFER=5000

# --- Stockage local (toujours actif) ---
SQLITE_PATH=data/analyzer.db

# --- Supabase (obligatoire pour le projet, facultatif pour demarrer) ---
# Project Settings -> API -> Project URL
SUPABASE_URL=
# Project Settings -> API -> service_role key  (SECRET : serveur uniquement)
SUPABASE_SERVICE_KEY=
# Table prefix optionnel
SUPABASE_ENABLED=false

# --- Enrichissement externe ---
# ipwho.is : HTTPS, sans cle, ~10 000 requetes/mois
ENRICH_ENABLED=true
ENRICH_CACHE_TTL_HOURS=24
# Optionnel : AbuseIPDB (necessite une cle gratuite)
ABUSEIPDB_API_KEY=

# --- Couche IA (facultative) ---
# L'IA ne fait que REFORMULER des donnees deja calculees. Jamais de faits inventes.
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

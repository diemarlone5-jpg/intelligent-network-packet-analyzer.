# --- Secrets : ne JAMAIS commiter ---
.env
.env.local
.env.prod

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- Donnees locales generees ---
# La base SQLite s'accompagne de deux fichiers de travail : le journal
# d'ecriture (…-wal) et la memoire partagee (…-shm). Les oublier faisait
# apparaitre des fichiers non suivis a chaque capture, et un « git add -A »
# les aurait commites.
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal
data/*.sqlite
data/*.sqlite3
data/*.sqlite-shm
data/*.sqlite-wal
data/captures/
*.pcap
*.pcapng

# --- Editeurs / OS ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# Journaux d execution
*.log

# Fichiers de travail temporaires (verifications manuelles).
# _j.txt contient un cookie de session : il ne doit jamais etre publie.
_*.txt
_*.html
_*.json
diag.pcap
gh-login.log
gcm-login.log
server.log
_frames/
